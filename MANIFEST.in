# setuptools-scm adds every git-tracked file to the sdist. Keep the library, the
# examples and the release documents; leave out CI, agent instructions, planning
# notes, tooling config and the tests (they need binary fixtures that do not belong in
# an sdist; run them from a git checkout).

prune .claude
prune .github
prune .import_linter_cache
prune tests

exclude .gitignore
exclude requirements-dev.txt
exclude *.md
include README.md CHANGELOG.md LICENSE
