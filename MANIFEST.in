# setuptools-scm adds every git-tracked file to the sdist. Keep the library, its tests,
# the examples and the release documents; leave out CI, agent instructions, planning
# notes, tooling config and binary test fixtures.

prune .claude
prune .github
prune .import_linter_cache
prune tests/fixtures

exclude .gitignore
exclude requirements-dev.txt
exclude *.md
include README.md CHANGELOG.md LICENSE
